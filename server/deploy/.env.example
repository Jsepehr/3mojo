# Configurazione del server Lemani — copiare in `deploy/.env` (mai nel repository,
# è in .gitignore) e compilare. Nessun valore qui è un segreto: sono tutti
# segnaposto. Elenco completo e spiegazioni in server/README.md.
#
# [OBBLIGATORIA]  senza, il server in produzione NON parte (RAEN_ENV=production,
#                 fissato dal docker-compose.yml).
# [CONSIGLIATA]   il server parte ma una funzione resta spenta o meno protetta.
# [OPZIONALE]     ha un default sensato.

# ---------------------------------------------------------------- dominio (Caddy)

# [OBBLIGATORIA] dominio pubblico del server (DNS già puntato qui).
RAEN_DOMAIN=api.example.com
# [OBBLIGATORIA] email per gli avvisi di scadenza del certificato (Let's Encrypt).
ACME_EMAIL=admin@example.com

# ---------------------------------------------------------------- pagamenti

# [OBBLIGATORIA] in produzione solo `real`.
PAYMENTS_MODE=real
# [OBBLIGATORIA] chiave HMAC fissa (32 byte in base64): `openssl rand -base64 32`.
# Senza, il server non parte: serve a far sopravvivere ai riavvii le transazioni
# già riscattate e gli sblocchi pagati (DATA_DIR). Cambiarla = perdere lo stato.
PAYMENTS_TRANSACTION_HASH_KEY=

# iOS (App Store). [OBBLIGATORIE per accendere iOS]
APPLE_BUNDLE_ID=
APPLE_PRODUCT_ID=
# sandbox | production (in production si accettano anche le transazioni Sandbox
# di App Review).
APPLE_ENVIRONMENT=production
# [OPZIONALI, tutte e tre insieme] chiave .p8 "Acquisti in-app": il file va in
# deploy/secrets/ e qui il percorso /run/secrets/<file>.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# [CONSIGLIATA] App Store Server Notifications v2: rimborsi revocano lo sblocco.
APPLE_NOTIFICATIONS_ENABLED=true

# Android (Google Play). [OBBLIGATORIE per accendere Android]
GOOGLE_PACKAGE_NAME=
GOOGLE_PRODUCT_ID=
# Service account JSON in deploy/secrets/ -> /run/secrets/<file>.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
# [CONSIGLIATA] Real-time Developer Notifications (>= 32 caratteri,
# `openssl rand -hex 32`); lo stesso valore nell'URL della sottoscrizione push.
GOOGLE_RTDN_TOKEN=

# [OPZIONALE] paid (default) | free. `free` = tutto gratis, nessuna foto
# bloccata per nessuno (primi mesi dopo il lancio). Per tornare a pagamento:
# togliere la riga (o `paid`) e riavviare il container, di notte. Le app non
# cambiano. Dettagli in server/README.md.
# PAYWALL_MODE=free

# ---------------------------------------------------------------- moderazione

# [OBBLIGATORIA] chiave AES-256 dei record di moderazione: `openssl rand -base64 32`.
MODERATION_KEY=
# [OBBLIGATORIA] token degli endpoint /admin/reports (>= 32 caratteri):
# `openssl rand -hex 32`.
ADMIN_TOKEN=
# [OPZIONALI]
# MODERATION_AUTO_CLOSE_REPORTS=3
# MODERATION_AUTO_CLOSE_MIN_IPS=2
# MODERATION_COOLDOWN_MINUTES=30

# ---------------------------------------------------------------- limiti e protocollo

# [OPZIONALE] tetto alle connessioni WebSocket aperte insieme (default 2000):
# tarare sul limite di memoria del container (docker-compose.yml).
# MAX_WS_CONNECTIONS=2000
# [OPZIONALE] nuovi Start per IP ogni 10 minuti (default 20).
# MAX_NEW_SESSIONS_PER_IP=20
# [OPZIONALE] alza il minimo del protocollo per forzare l'aggiornamento delle
# app (default: N-1). Vedi server/README.md "Versione del protocollo".
# MIN_PROTOCOL_VERSION=
# [OPZIONALE] origini ammesse dal CORS (in produzione, senza, nessun header
# CORS: le app mobili non ne hanno bisogno). Elenco separato da virgole.
# CORS_ALLOW_ORIGIN=

# ---------------------------------------------------------------- osservabilità

# [CONSIGLIATA] token di GET /metrics (>= 32 caratteri) per uno scraper nella rete
# interna; senza, /metrics risponde solo da loopback nel container.
METRICS_TOKEN=
# [OPZIONALE] debug | info | warn | error (default info).
# LOG_LEVEL=info

# ---------------------------------------------------------------- verifica del dispositivo

# [CONSIGLIATA al lancio, poi] off | log | enforce. Vedi server/README.md.
ATTESTATION_MODE=off
# Solo con log/enforce:
# APPLE_TEAM_ID=
# APPLE_APP_ATTEST_ENVIRONMENT=production
# PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON_PATH=

# ---------------------------------------------------------------- NON impostare in produzione
# Il server rifiuta di partire (RAEN_ENV=production) se compaiono:
#   DEBUG_ENDPOINTS_TOKEN, ADMIN_ALLOW_INSECURE_HTTP, ATTESTATION_ALLOW_FAKE
# e PAYMENTS_MODE=fake.
