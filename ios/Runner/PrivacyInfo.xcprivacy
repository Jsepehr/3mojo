<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest dell'app (non dei plugin: ogni plugin porta il suo).
  - Nessun tracking, nessun dominio di tracking.
  - Dati raccolti, solo per far funzionare l'app, mai collegati a
    un'identità (niente account, niente identificativo fisso del
    dispositivo; la sessione esiste solo da online):
      posizione precisa (presenza, raggio 100 m), selfie della sessione,
      informazioni sensibili (genere + chi vuoi incontrare = possibile
      orientamento, art. 9 GDPR), messaggi della chat (inoltrati, non
      conservati dal server).
  - ECCEZIONE alla "nessuna conservazione" (blocca/segnala): se una
    sessione viene segnalata, il server conserva il selfie di quella
    persona in un record di moderazione cifrato (con motivi, conteggio e
    ora al minuto; niente posizione, chat, IP o identificativi) per al più
    30 giorni, per la revisione umana. DA RIVEDERE nelle dichiarazioni
    (qui e in App Store Connect / Data safety di Play) nella fase
    dedicata: la voce "PhotosorVideos" oggi dichiara solo
    AppFunctionality e non dice della conservazione per la moderazione.
  - API "required reason": UserDefaults (CA92.1) — shared_preferences,
    usato solo per dati dell'app stessa, letti e scritti solo da lei: le
    impostazioni (lingua, tema, modalità finta in debug), il segno di
    installazione (per cancellare i dati cifrati rimasti nel Keychain da
    un'installazione precedente) e la pulizia di vecchie chiavi (token di
    sblocco e chat delle versioni precedenti). Nessun dato condiviso con
    altre app né usato per il tracking.
  Da tenere allineato con le "App Privacy" di App Store Connect.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeSensitiveInfo</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailsOrTextMessages</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
